{
  "name": "dsh-music-ball",
  "version": "1.0.0",
  "private": false,
  "type": "commonjs",
  "description": "A draggable black-and-white music ball for the DeepSeek Harness Web UI, with local music, album covers, playlists, favorites, collections, and source-aware deletion.",
  "license": "MIT",
  "author": "Ziliang571",
  "homepage": "https://github.com/Ziliang571/dsh-music-ball",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ziliang571/dsh-music-ball.git"
  },
  "bugs": {
    "url": "https://github.com/Ziliang571/dsh-music-ball/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "music",
    "music-player",
    "floating-ball",
    "playlist"
  ],
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "exports": {
    ".": "./host.cjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "main": "./host.cjs",
  "files": [
    "host.cjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
